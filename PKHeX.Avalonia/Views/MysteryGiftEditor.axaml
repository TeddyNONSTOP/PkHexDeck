<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PKHeX.Presentation.ViewModels;assembly=PKHeX.Presentation"
             xmlns:loc="using:PKHeX.Avalonia.Localization"
             x:Class="PKHeX.Avalonia.Views.MysteryGiftEditor"
             x:DataType="vm:MysteryGiftEditorViewModel">

    <Border Classes="view-container">
        <Panel>
            <!-- Not supported message -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding !HasAnySupport}">
                <TextBlock Text="{loc:Loc MysteryGiftEditor_NotAvailable}"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Opacity="0.7" />
                <TextBlock Text="{loc:Loc MysteryGiftEditor_NotAvailableDescription}"
                           HorizontalAlignment="Center"
                           Opacity="0.5"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Main editor -->
            <DockPanel IsVisible="{Binding IsSupported}">
                <!-- Header -->
                <DockPanel Classes="save-editor-header" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{loc:Loc MysteryGiftEditor_Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding GiftCountText}"
                               VerticalAlignment="Center"
                               Opacity="0.6"
                               Margin="8,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{loc:Loc MysteryGiftEditor_Reset}" Command="{Binding ResetCommand}" Padding="12,6" />
                        <Button Content="{loc:Loc MysteryGiftEditor_Apply}" Command="{Binding SaveCommand}" Classes="accent" Padding="12,6" />
                    </StackPanel>
                </DockPanel>

                <!-- Content -->
                <Grid ColumnDefinitions="*,8,*">
                    <!-- Gift List -->
                    <Border Grid.Column="0"
                            Classes="editor-section"
                           >
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Gifts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:MysteryGiftSlotViewModel">
                                        <Button AutomationProperties.Name="{Binding Title}" Classes="auxiliary-list-item"
                                                Command="{Binding $parent[ItemsControl].((vm:MysteryGiftEditorViewModel)DataContext).SelectGiftCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Left"
                                                HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,40,*">
                                                <!-- Empty/Filled indicator -->
                                                <Panel Grid.Column="0" Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Ellipse Fill="Gray" IsVisible="{Binding IsEmpty}" />
                                                    <Ellipse Fill="LimeGreen" IsVisible="{Binding !IsEmpty}" />
                                                </Panel>

                                                <Image Grid.Column="1" Source="{Binding Sprite, Converter={StaticResource PngBytesToBitmap}}" Width="32" Height="32" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Species}"
                                                               Opacity="0.7"
                                                               FontSize="12"
                                                               IsVisible="{Binding !IsEmpty}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Selected Gift Details -->
                    <Grid Grid.Column="2" RowDefinitions="3*,8,2*">
                        <!-- Selected Gift Details -->
                        <Border Grid.Row="0"
                                Classes="editor-section"
                                Padding="8">
                            <DockPanel>

                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Button Content="{loc:Loc MysteryGiftEditor_Import}"
                                            Command="{Binding ImportGiftCommand}"
                                            Margin="0,0,4,4"
                                            HorizontalContentAlignment="Center" />
                                    <Button Content="{loc:Loc MysteryGiftEditor_Export}"
                                            Command="{Binding ExportGiftCommand}"
                                            IsEnabled="{Binding !SelectedGift.IsEmpty}"
                                            Margin="0,0,4,4"
                                            HorizontalContentAlignment="Center" />
                                    <Button Content="{loc:Loc Common_Delete}"
                                            Command="{Binding DeleteGiftCommand}"
                                            IsEnabled="{Binding !SelectedGift.IsEmpty}"
                                            Margin="0,0,4,4"
                                            HorizontalContentAlignment="Center" />
                                </WrapPanel>

                            <ScrollViewer Name="CardPreviewScroll">
                            <StackPanel Spacing="8" DataContext="{Binding SelectedGift}">
                                <TextBlock Text="{loc:Loc MysteryGiftEditor_SelectedGift}"
                                           FontWeight="SemiBold"
                                           FontSize="16" />

                                <!-- Gift Info -->
                                <StackPanel Spacing="8" IsVisible="{Binding !IsEmpty}">
                                    <Grid ColumnDefinitions="40,*">
                                        <Image Source="{Binding Sprite, Converter={StaticResource PngBytesToBitmap}}" Width="32" Height="32" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding CardIdentity}" TextWrapping="Wrap" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding PreviewRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:GiftPreviewRow">
                                                <Grid ColumnDefinitions="*,2*" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Text="{loc:Loc MysteryGiftEditor_EmptySlot}"
                                           Opacity="0.5"
                                           IsVisible="{Binding IsEmpty}" />

                            </StackPanel>
                            </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Received Flags -->
                        <Border Grid.Row="2"
                                IsVisible="{Binding CanManageFlags}"
                                Classes="editor-section"
                                Padding="8">
                             <DockPanel>
                                 <TextBlock DockPanel.Dock="Top" Text="{loc:Loc MysteryGiftEditor_ReceivedFlags}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                 <WrapPanel DockPanel.Dock="Top">
                                     <Button Content="{loc:Loc GiftPreview_ImportIds}" Command="{Binding ImportReceivedIdsCommand}" Margin="0,0,4,4" />
                                     <Button Content="{loc:Loc GiftPreview_ExportIds}" Command="{Binding ExportReceivedIdsCommand}" Margin="0,0,4,4" />
                                     <Button Content="{loc:Loc GiftPreview_AllUsed}" Command="{Binding AllUsedCommand}" Margin="0,0,4,4" />
                                     <Button Content="{loc:Loc GiftPreview_AllUnused}" Command="{Binding AllUnusedCommand}" Margin="0,0,4,4" />
                                 </WrapPanel>
                                 <Button DockPanel.Dock="Bottom" Content="{loc:Loc MysteryGiftEditor_DeleteFlag}"
                                         Command="{Binding DeleteFlagCommand}" 
                                         HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                                 <ListBox ItemsSource="{Binding ReceivedFlags}" SelectedItem="{Binding SelectedReceivedFlag}" 
                                          Background="Transparent"/>
                             </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </DockPanel>

            <!-- Gift record log (Switch titles: received-gift history, no insertable album) -->
            <DockPanel IsVisible="{Binding IsRecordsSupported}">
                <!-- Header -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="{loc:Loc MysteryGiftEditor_RecordsTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RecordCountText}"
                               VerticalAlignment="Center"
                               Opacity="0.6"
                               Margin="8,0,0,0" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="{loc:Loc MysteryGiftEditor_RecordsDescription}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Opacity="0.6"
                           Margin="0,0,0,12" />

                <!-- Content -->
                <Grid ColumnDefinitions="*,8,300">
                    <!-- Record List -->
                    <Border Grid.Column="0"
                            Classes="editor-section"
                           >
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Records}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:GiftRecordEntryViewModel">
                                        <Button Classes="auxiliary-list-item"
                                                Command="{Binding $parent[ItemsControl].((vm:MysteryGiftEditorViewModel)DataContext).SelectRecordCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Left"
                                                HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Panel Grid.Column="0" Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Ellipse Fill="Gray" IsVisible="{Binding IsEmpty}" />
                                                    <Ellipse Fill="LimeGreen" IsVisible="{Binding !IsEmpty}" />
                                                </Panel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}"
                                                               Opacity="0.7"
                                                               FontSize="12"
                                                               IsVisible="{Binding !IsEmpty}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Selected Record + management cards -->
                    <Grid Grid.Column="2" RowDefinitions="*,Auto,Auto">
                        <!-- Selected Record Details -->
                        <Border Grid.Row="0"
                                Classes="editor-section"
                                Padding="8">
                            <StackPanel Spacing="8" DataContext="{Binding SelectedRecord}">
                                <TextBlock Text="{loc:Loc MysteryGiftEditor_SelectedRecord}"
                                           FontWeight="SemiBold"
                                           FontSize="16" />

                                <StackPanel Spacing="8" IsVisible="{Binding !IsEmpty}">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Text="{loc:Loc MysteryGiftEditor_EmptySlot}"
                                           Opacity="0.5"
                                           IsVisible="{Binding IsEmpty}" />

                                <StackPanel Spacing="8" Margin="0,8,0,0">
                                    <Button Content="{loc:Loc MysteryGiftEditor_Import}"
                                            Command="{Binding $parent[Border].((vm:MysteryGiftEditorViewModel)DataContext).ImportRecordCommand}"
                                            IsVisible="{Binding $parent[Border].((vm:MysteryGiftEditorViewModel)DataContext).CanImportRecord}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />
                                    <Button Content="{loc:Loc MysteryGiftEditor_Export}"
                                            Command="{Binding $parent[Border].((vm:MysteryGiftEditorViewModel)DataContext).ExportRecordCommand}"
                                            IsVisible="{Binding $parent[Border].((vm:MysteryGiftEditorViewModel)DataContext).CanExportRecord}"
                                            IsEnabled="{Binding !IsEmpty}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />
                                    <Button Content="{loc:Loc Common_Delete}"
                                            Command="{Binding $parent[Border].((vm:MysteryGiftEditorViewModel)DataContext).DeleteRecordCommand}"
                                            IsEnabled="{Binding !IsEmpty}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Received Flags (BDSP) -->
                        <Border Grid.Row="1"
                                IsVisible="{Binding CanManageRecordFlags}"
                                Classes="editor-section"
                                Padding="8"
                                Height="180"
                                Margin="0,8,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc MysteryGiftEditor_ReceivedFlags}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Button DockPanel.Dock="Bottom" Content="{loc:Loc MysteryGiftEditor_DeleteFlag}"
                                        Command="{Binding DeleteRecordFlagCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                                <ListBox ItemsSource="{Binding RecordReceivedFlags}" SelectedItem="{Binding SelectedRecordFlag}"
                                         Background="Transparent" />
                            </DockPanel>
                        </Border>

                        <!-- Serial-code lock (BDSP) -->
                        <Border Grid.Row="2"
                                IsVisible="{Binding HasSerialLock}"
                                Classes="editor-section"
                                Padding="8"
                                Margin="0,8,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Loc MysteryGiftEditor_SerialLockTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SerialLockText}" Opacity="0.7" TextWrapping="Wrap" />
                                <Button Content="{loc:Loc MysteryGiftEditor_ResetSerialLock}"
                                        Command="{Binding ResetSerialLockCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </DockPanel>
        </Panel>
    </Border>
</UserControl>
