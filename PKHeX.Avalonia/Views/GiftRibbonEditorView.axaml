<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PKHeX.Presentation.ViewModels;assembly=PKHeX.Presentation"
             xmlns:loc="using:PKHeX.Avalonia.Localization"
             x:Class="PKHeX.Avalonia.Views.GiftRibbonEditorView"
             x:DataType="vm:GiftRibbonEditorViewModel"
             Width="560" Height="520">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    </UserControl.KeyBindings>

    <Border Classes="view-container">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,12,0,0">
                <Button Content="{loc:Loc GiftRibbonEditor_AllLegal}" Command="{Binding AllLegalCommand}" />
                <Button Content="{loc:Loc GiftRibbonEditor_Clear}" Command="{Binding ClearCommand}" />
                <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelCommand}" />
                <Button Content="{loc:Loc Common_Save}" Command="{Binding SaveCommand}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12" Spacing="4">
                <TextBlock Text="{loc:Loc Dialog_GiftRibbons}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding GenerationLabel}" Classes="form-hint" />
                <Grid ColumnDefinitions="*,150" Margin="4,8,4,0">
                    <TextBlock Text="{loc:Loc GiftRibbonEditor_RibbonColumn}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{loc:Loc GiftRibbonEditor_DescriptionIndex}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                </Grid>
            </StackPanel>

            <Border Classes="editor-section-padded" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Ribbons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GiftRibbonItemViewModel">
                                <Grid ColumnDefinitions="*,150" Margin="4,3">
                                    <TextBlock Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding DisplayName}" />
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding DescriptionIndex}"
                                                   AutomationProperties.Name="{Binding DescriptionIndexAutomationName}"
                                                   Minimum="0"
                                                   Maximum="255"
                                                   Width="120"
                                                   HorizontalAlignment="Center"
                                                   ShowButtonSpinner="False" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
